# 1 sends title, artist, and album to MusicBrainz and downloads a matching
# cover from the Cover Art Archive.
WAYDROID_APPLE_MPRIS_CATALOG_ARTWORK=0

# 1 keeps Android's music stream at 15/15 and disables its Waydroid-side cap.
WAYDROID_APPLE_MPRIS_FORCE_VOLUME=0

# 1 watches PipeWire events and restarts Waydroid if Apple Music says it is
# playing but Waydroid has no output stream. It is off unless you choose it.
WAYDROID_APPLE_MPRIS_AUDIO_WATCHDOG=0

# Seconds to wait after a missing-stream event before recovery. This is a
# grace period, not a polling timer.
WAYDROID_APPLE_MPRIS_WATCHDOG_GRACE=1.0

# Leave blank to use the system adb chosen by install.sh.
WAYDROID_APPLE_MPRIS_ADB=
